generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  personas  Persona[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Persona {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  sessions  Session[]
  club      Club?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  personaId Int
  persona   Persona   @relation(fields: [personaId], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

model Club {
  id        Int       @id @default(autoincrement())
  name      String
  personaId Int       @unique
  persona   Persona   @relation(fields: [personaId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
