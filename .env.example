# PostgreSQL (local: npx prisma dev --name fifa17 --detach)
DATABASE_URL="postgres://postgres:postgres@localhost:51218/fifa17?sslmode=disable"

# Bind address for all local services
HOST=127.0.0.1

# Blaze redirector (gosredirector.ea.com)
REDIRECTOR_PORT=42127

# Main Blaze TCP server
BLAZE_PORT=10041
BLAZE_PUBLIC_HOST=127.0.0.1

# Nucleus / Origin auth stub (HTTP)
NUCLEUS_PORT=4433

# FUT HTTP API
FUT_PORT=8080

# Packet dump directory
LOG_DIR=./logs

# Fake persona defaults
DEFAULT_PERSONA_NAME=LocalPlayer
DEFAULT_NUCLEUS_ID=1000000001
DEFAULT_PERSONA_ID=2000000001

# Optional Auth gate A/B: advertise Authentication (1) + Util (9) in PreAuth.
# Leave empty for the proven stable baseline.
BLAZE_PREAUTH_CIDS=

# Optional isolated Auth source A/B. Leave empty for the stable baseline.
BLAZE_PREAUTH_ASRC=

# Optional isolated registration/entitlement source A/B.
BLAZE_PREAUTH_RSRC=

# Stable default: ignore Util/2. Set to 0 only for the isolated corrected-codec test.
PING_SWALLOW=1
