{
	"name":"futLogInFlow"
	, "initial":
	{
		"targets":["FUTLoginStart"]
	}
	,"onExit":
	[
		["unloadViewModel",["FUTLoginViewModel"]]
	]
	,"states":
	[
		{
			"name":"FUTLoginFlow_Wrapper"
			,"onEnter":
			[
				["invoke", ["evt_invite_flow_ready"]]
			]
			,"states":
			[
				{
					"name":"FUTLoginStart"
					,"onEnter":
					[
						["loadViewModel",["FUTLoginViewModel"]]
						,["sendAction",["condition", "beginFUTLogin"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["loadFUTGlobalViewModels"]
						},
						{
							"event":"ShowMainMenu"
							,"targets":["quit"]
						}
					]
				}
				,{
					"name":"loadFUTGlobalViewModels"
					,"onEnter":
					[
						["loadViewModel",["futglobalviewmodel"]]
						,["loadViewModel",["futdronecommandviewmodel"]]
						,["loadViewModel",["futprofilerviewmodel"]]
						,["loadViewModel",["futplayeridentityviewmodel"]]
						,["sendScreenEvent", ["ShowFELoadingIcon"]]
						,["invoke", ["advance"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["captcha"]
						}
					]
				}
				,{
					"name":"captcha"
					,"onEnter":
					[
						["loadViewModel",["futcaptchaviewmodel"]]
						,["loadView",["screen", "external/ion_fut/screens/security/futCaptcha"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "external/ion_fut/screens/security/futCaptcha"]]
						,["unloadViewModel",["futcaptchaviewmodel"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["deviceRestrictions"]
						}
						,{
							"event":"back"
							,"targets":["back"]
						}
					]
				}
				,{
					"name":"deviceRestrictions"
					,"onEnter":
					[
						["loadView",["screen", "external/ion_fut/screens/security/futDeviceRestrictions"]]
						,["loadViewModel",["futdevicerestrictionviewmodel"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "external/ion_fut/screens/security/futDeviceRestrictions"]]
						,["unloadViewModel",["futdevicerestrictionviewmodel"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["security"]
						}
						,{
							"event":"back"
							,"targets":["back"]
						}
					]
				}
				,{
					"name":"security"
					,"onEnter":
					[
						["loadView",["screen", "external/ion_fut/screens/security/futSecurityQuestion"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "external/ion_fut/screens/security/futSecurityQuestion"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["futSaveGM"]
						}
						,{
							"event":"back"
							,"targets":["back"]
						}
					]
				}
				,{
					"name":"futSaveGM"
					,"onEnter":
					[
						["sendScreenEvent", ["UXSaveGMTrackerInfo", ".GameModeRecordID.GM_ULTIMATE_TEAM"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["RetrieveUserData"]
						}
					]
				}
				,{
					"name":"RetrieveUserData"
					,"onEnter":
					[
						["sendAction",["condition", "retrieveUserData"]]
					]
					,"transitions":
					[
						{
							"event":"ClubChangeSuccess"
							,"targets":["CheckRewards"]
						}
						,{
							"event":"advance"
							,"targets":["CheckRewards"]
						}
						,{
							"event":"createClub"
							,"targets":["createClub"]
						}
						,{
							"event":"changeClubName"
							,"targets":["changeClubName"]
						}
					]
				}
				,{
					"name":"FinalizeLogin_Wrapper"
					,"onExit":
					[
						["unloadViewModel",["FUTLoginViewModel"]]
						,["sendScreenEvent", ["HideFELoadingIcon"]]
					]
					,"states":
					[
						{
							"name":"CheckRewards"
							,"onEnter":
							[
								["sendAction",["condition", "CheckRewards"]]
							]
							,"transitions":
							[
								{
									"event":"CheckRewardsComplete"
									,"targets":["CheckRewardsComplete"]
								}
							]
						}
						,{
							"name":"CheckRewardsComplete"
							,"onEnter":
							[
								["sendAction",["condition", "loginComplete"]]
							]
						}
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["advance"]
						}
						,{
							"event":"GotoNewItemScreen"
							,"targets":["newItems"]
						}
						,{
							"event":"TriggerInviteFlow"
							,"targets":["InviteFlowTriggered"]
						}
						,{
							"event":"GotoStarterSquadWithNewItem"
							,"targets":["starterSquadIntroToNewItems"]
						}
						,{
							"event":"GotoStarterSquad"
							,"targets":["starterSquadIntro"]
						}
					]
				}	
				,{
					"name":"createClub"
					,"onEnter":
					[
						["loadViewModel",["futcreateclubviewmodel", "1"]]
						,["loadView",["screen", "external/ion_fut/screens/FutCreateClub"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "external/ion_fut/screens/FutCreateClub"]]
						,["unloadViewModel",["futcreateclubviewmodel"]]
						,["unloadView", ["background"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["RetrieveUserData"]
						}
						,{
							"event":"back"
							,"targets":["back"]
						}
						,{
							"event":"back"
							,"targets":["back"]
						}
						,{
							"event":"BlurBackground"
							,"actions":[ ["loadView", ["background", "FIFA", "2"]] ]
						}
					]
				}
				,{
					"name":"changeClubName"
					,"onEnter":
					[
						["loadViewModel",["futcreateclubviewmodel", "2"]]
						,["loadView",["screen", "external/ion_fut/screens/FutCreateClub"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "external/ion_fut/screens/FutCreateClub"]]
						,["unloadViewModel",["futcreateclubviewmodel"]]
					]
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["CheckRewards"]
						},
						{
							"event":"back"
							,"targets":["back"]
						}
					]
				}
			]
			,"transitions":
			[
				{
					"event":"goToInviteFlow"
					,"actions":[ ["sendScreenEvent", ["CatchInviteAtFUTLogin"]] ]
				}
			]
		}
		,{
			"name":"starterSquadIntro_Wrapper"
			,"onEnter":
			[
				["loadView",["screen", "external/ion_fut/screens/FutStarterSquadIntro"]]
			]
			,"onExit":
			[
				["unloadView",["screen", "external/ion_fut/screens/FutStarterSquadIntro"]]
			]
			,"states":
			[
				{
					"name":"starterSquadIntro"
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["starterSquad"]
						}
						,{
							"event":"OpenPackAnim"
							,"targets":["OpenPackAnim"]
						}
					]
				}
				,{
					"name":"OpenPackAnim"
					,"type":"external"
					,"file":"/fut/futOpenPackAnimFlow.nav"
					,"outputs": 
					{ 
						"back":"starterSquad"
					}
				}
				,{
					"name":"starterSquadIntroToNewItems"
					,"transitions":
					[
						{
							"event":"advance"
							,"targets":["newItems_StarterSquad"]
						}
						,{
							"event":"OpenPackAnim"
							,"targets":["OpenPackAnimToNewItems"]
						}
					]
				}
				,{
					"name":"OpenPackAnimToNewItems"
					,"type":"external"
					,"file":"/fut/futOpenPackAnimFlow.nav"
					,"outputs": 
					{ 
						"back":"newItems_StarterSquad"
					}
				}
				,{
					"name":"newItems_StarterSquad"
					,"type":"external"
					,"file":"/fut/futNewItemsFlow.nav"
					,"outputs":
					{
						"back":"starterSquad"
					}
				}
				,{
					"name":"starterSquad"
					,"type":"external"
					,"file":"/fut/squads/futSquadsFlow.nav"
					,"outputs":
					{
						"back":"advance"
						,"advance":"advance"
					}
				}
			]
			,"transitions":
			[
				{
					"event":"goToInviteFlow"
					,"actions":[ ["sendScreenEvent", ["ShowOnboardingInviteErrPopup"]] ]
				}
			]
		}
		,{
			"name":"InviteFlowTriggered"
			,"onEnter":
			[
				["sendScreenEvent", ["AdvanceUserToSession"]]
			]
		}
		,{
			"name":"newItems"
			,"type":"external"
			,"file":"/fut/futNewItemsFlow.nav"
			,"outputs":
			{
				"back":"advance"
			}
		}
	]
}
